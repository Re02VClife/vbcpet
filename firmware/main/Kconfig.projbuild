menu "vbcpet Display"

    choice DISPLAY_BACKEND
        prompt "Display Backend"
        default DISPLAY_BACKEND_SPI
        help
            Select the display hardware backend.
            SPI = ST7789V 240×320 (WT9932P4-TINY)
            DSI = MIPI DSI LCD (鱼鹰 ESP32-P4C6-Core, 480×800 ST7102)

        config DISPLAY_BACKEND_SPI
            bool "SPI (ST7789V 240×320)"
        config DISPLAY_BACKEND_DSI
            bool "MIPI DSI (480×800)"
    endchoice

    config VBCPET_DISPLAY_W
        int "Display width (px)"
        default 480 if DISPLAY_BACKEND_DSI
        default 240

    config VBCPET_DISPLAY_H
        int "Display height (px)"
        default 800 if DISPLAY_BACKEND_DSI
        default 320

    choice VBCPET_DISPLAY_FORMAT
        prompt "Frame buffer pixel format (PPA JPEG decode output)"
        default VBCPET_DISPLAY_FORMAT_RGB565
        help
            RGB565 = 16bpp, 480×800 → 768KB (较小, SPI 直刷)
            RGB888 = 24bpp, 480×800 → 1.15MB (部分 MIPI 面板需要)

        config VBCPET_DISPLAY_FORMAT_RGB565
            bool "RGB565 (16bpp)"
        config VBCPET_DISPLAY_FORMAT_RGB888
            bool "RGB888 (24bpp)"
    endchoice

    config VBCPET_SKIP_DISPLAY
        bool "Skip display init (bring-up: no panel / DSI not working)"
        default n
        help
            Skip the panel backend init (MIPI-DSI / SPI) and run with a NULL
            panel handle. Used during hardware bring-up to bring up the other
            peripherals (buttons/LED/audio/IMU/SD/servo/NFC/USB) and the UART0
            console when the display is not connected or its init hangs.

    config VBCPET_TRANSPORT_UART
        bool "Stream transport over UART0/CH340 (console must be NONE)"
        default n
        help
            V1 板 USJ(GPIO24/25) 被舵机 PWM 占用, 推流改走 CH340 UART0。
            勾选后 app_main 用 UART 传输; 需同时设 CONFIG_ESP_CONSOLE_NONE
            并跳过 bringup 控制台 (否则两个读者抢 UART0 字节)。

    config VBCPET_UART_BAUDRATE
        int "UART transport baudrate"
        default 2000000
        depends on VBCPET_TRANSPORT_UART

endmenu

menu "vbcpet Bring-up Debug"

    config VBCPET_MINIMAL_USJ
        bool "Minimal USB-Serial/JTAG isolation test"
        default n
        help
            Boot straight into a minimal test: install the USB-Serial/JTAG
            driver only (+ SK6812 LED heartbeat), skip host / display / engine
            / peripheral init entirely. Used to isolate why the USB console
            does not enumerate in normal mode.
            LED: blink = app alive; green = USJ driver OK, red = install failed.

endmenu
