menu "vbcpet Display"

    choice DISPLAY_BACKEND
        prompt "Display Backend"
        default DISPLAY_BACKEND_SPI
        help
            Select the display hardware backend.
            SPI = ST7789V 240×320 (WT9932P4-TINY)
            DSI = MIPI DSI LCD (鱼鹰 ESP32-P4C6-Core, 480×800 ST7102)

        config DISPLAY_BACKEND_SPI
            bool "SPI (ST7789V 240×320)"
        config DISPLAY_BACKEND_DSI
            bool "MIPI DSI (480×800)"
    endchoice

    config VBCPET_DISPLAY_W
        int "Display width (px)"
        default 480 if DISPLAY_BACKEND_DSI
        default 240

    config VBCPET_DISPLAY_H
        int "Display height (px)"
        default 800 if DISPLAY_BACKEND_DSI
        default 320

    choice VBCPET_DISPLAY_FORMAT
        prompt "Frame buffer pixel format (PPA JPEG decode output)"
        default VBCPET_DISPLAY_FORMAT_RGB565
        help
            RGB565 = 16bpp, 480×800 → 768KB (较小, SPI 直刷)
            RGB888 = 24bpp, 480×800 → 1.15MB (部分 MIPI 面板需要)

        config VBCPET_DISPLAY_FORMAT_RGB565
            bool "RGB565 (16bpp)"
        config VBCPET_DISPLAY_FORMAT_RGB888
            bool "RGB888 (24bpp)"
    endchoice

    config VBCPET_SKIP_DISPLAY
        bool "Skip display init (bring-up: no panel / DSI not working)"
        default n
        help
            Skip the panel backend init (MIPI-DSI / SPI) and run with a NULL
            panel handle. Used during hardware bring-up to bring up the other
            peripherals (buttons/LED/audio/IMU/SD/servo/NFC/USB) and the UART0
            console when the display is not connected or its init hangs.

    config VBCPET_TRANSPORT_UART
        bool "Stream transport over UART0/CH340 (console must be NONE)"
        default n
        help
            V1 板 USJ(GPIO24/25) 被舵机 PWM 占用, 推流改走 CH340 UART0。
            勾选后 app_main 用 UART 传输; 需同时设 CONFIG_ESP_CONSOLE_NONE
            并跳过 bringup 控制台 (否则两个读者抢 UART0 字节)。

    config VBCPET_UART_BAUDRATE
        int "UART transport baudrate"
        default 2000000
        depends on VBCPET_TRANSPORT_UART

endmenu

menu "vbcpet WiFi (模组内 ESP32-C6 + esp-hosted)"

    config VBCPET_ENABLE_WIFI
        bool "Enable WiFi via on-module ESP32-C6 (esp-hosted/SDIO)"
        default n
        help
            ESP32-P4 无原生 WiFi。模组 ESP32-P4C6-Core 内含 ESP32-C6FH4,
            与 P4 经**模组内部 SDIO**(未引出的 GPIO14-19) 互联, C6 侧需运行
            esp-hosted slave 固件, P4 侧用 esp_hosted + esp_wifi_remote。
            勾选后: 启动时初始化 hosted 传输 + esp_wifi (STA), 控制台多一个
            "wifi" 命令 (scan/info/conn/status)。需 WiFi 天线 (模组 pin2/ANT)。

    config VBCPET_WIFI_PROBE_ON_BOOT
        bool "Run WiFi probe at boot (CP info + AP scan)"
        depends on VBCPET_ENABLE_WIFI
        default y
        help
            开机 4 秒后自动跑一次探测: 打印 C6 芯片信息 + slave 固件版本 +
            扫描到的 AP 列表 (SSID/RSSI/信道)。W0 阶段用来一次性确认
            "C6 有没有烧 slave 固件" 和 "天线行不行"。

    config VBCPET_WIFI_SSID
        string "Default WiFi SSID (for 'wifi conn' / boot auto-connect)"
        depends on VBCPET_ENABLE_WIFI
        default ""

    config VBCPET_WIFI_PASSWORD
        string "Default WiFi password"
        depends on VBCPET_ENABLE_WIFI
        default ""

endmenu

menu "vbcpet C6 烧录通道 (P4 当 C6 的编程器)"

    config VBCPET_C6_FLASH
        bool "Enable P4-as-C6-programmer (UART + esp-serial-flasher)"
        default n
        help
            模组里的 ESP32-C6 只引出 UART(pin4/5) 与 BOOT strap(pin9)。把这两组线接到
            P4 的空闲 GPIO 后, P4 就能自己把 C6 的固件写进去 (官方 esp-serial-flasher)。
            控制台命令: c6flash / c6mon。镜像以 EMBED 方式烧进 P4 固件 (main/c6_merged.bin)。

    config VBCPET_C6_WAKE_SCAN
        bool "开机先做 C6 唤醒扫描 (试 GPIO54/53/52/0 × 高/低/高阻 找 C6 的 EN)"
        depends on VBCPET_C6_FLASH_ON_BOOT
        default n
        help
            模组未引出 C6 的 EN; 若模组内部把 C6 EN 接到了某个 P4 GPIO, 而板子上该脚悬空,
            C6 就会一直处于未使能状态 (表现为 SDIO 不枚举 / UART 无响应)。
            勾上后每次开机自动扫描候选脚, 并打印每种组合下 C6 是否有字节输出。

    config VBCPET_C6_FLASH_ON_BOOT
        bool "开机 5 秒后自动执行 c6flash (完全不依赖控制台)"
        depends on VBCPET_C6_FLASH
        default n
        help
            控制台一旦僵死 (项目已知 bug B1: UART0 控制台复位后 1-3 分钟冻结),
            就没办法手敲 c6flash。勾上这个: 每次启动 5 秒后在后台自动尝试给 C6
            烧固件 (C6 在 ROM 下载模式才会响应; 等 45s 没反应就安静放弃, 不影响其他功能)。

    config VBCPET_C6_UART_TX_GPIO
        int "P4 GPIO → 模组 pin4 (C6_U0RXD)"
        depends on VBCPET_C6_FLASH
        default 30

    config VBCPET_C6_UART_RX_GPIO
        int "P4 GPIO ← 模组 pin5 (C6_U0TXD)"
        depends on VBCPET_C6_FLASH
        default 31

    config VBCPET_C6_BOOT_GPIO
        int "P4 GPIO → 模组 pin9 (C6_IO9), -1 = 那根线直接接 GND"
        depends on VBCPET_C6_FLASH
        default -1

    config VBCPET_C6_SPARE_GPIO_A
        int "空闲 GPIO 借给 flasher 当 reset 脚 (板上未接, 无副作用)"
        depends on VBCPET_C6_FLASH
        default 53

    config VBCPET_C6_SPARE_GPIO_B
        int "空闲 GPIO 借给 flasher 当 boot 脚 (板上未接, 无副作用)"
        depends on VBCPET_C6_FLASH
        default 52

endmenu

menu "vbcpet IO 供电 (LDO_VO4 → GPIO39~48)"

    config VBCPET_LDO_VO4_MV
        int "LDO_VO4 输出电压 mV (0 = 不配置此轨)"
        default 3300
        range 0 3300
        help
            模组 pin66 = ESP_LDO_VO4 的输出, 它同时就是 GPIO39~48 这一组 pad 的 IO 供电轨。
            复位后默认约 1.2V, 若无人配置则一直是 1.2V, 后果是 SD 卡 init failed、
            PA_EN(GPIO46) 拉不起、MPU_INT(GPIO47) 收不到、BL_PWM(GPIO48) 驱不动 MT3608 EN
            —— 2026-09-24/25 实测定案。

            500~2700 走片内 LDO 调压档; 3300 是"直通输入轨"(bypass) 档, 也是 SD 卡的
            标准电平, 故默认 3300。设 0 表示不配置 (开发板 / 无此轨的场合)。

            ⚠️ IDF 约束: adjustable 通道不能被 acquire 两次。本项在 app_main 里统一
            acquire 一次, 其它地方 (含 SD 驱动的 sd_pwr_ctrl_new_on_chip_ldo) 不要再碰通道 4。

            参考: 模组手册 pin66 "Output power supply (output voltage range 0.5-2.7V or 3.3V,
                  maximum output current 0.2A)"
                  IDF components/sdmmc/include/sd_pwr_ctrl_by_on_chip_ldo.h

endmenu

menu "vbcpet Bring-up Debug"

    config VBCPET_MINIMAL_USJ
        bool "Minimal USB-Serial/JTAG isolation test"
        default n
        help
            Boot straight into a minimal test: install the USB-Serial/JTAG
            driver only (+ SK6812 LED heartbeat), skip host / display / engine
            / peripheral init entirely. Used to isolate why the USB console
            does not enumerate in normal mode.
            LED: blink = app alive; green = USJ driver OK, red = install failed.

endmenu
