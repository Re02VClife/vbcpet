# vbcpet firmware — ESP32-P4 Wokwi Beta default config
# 在 ESP-IDF v5.4+ 下使用: idf.py set-target esp32p4
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# 串口 (Wokwi 默认)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0

# WiFi 占位 (P4 无原生 WiFi, 后续经 C6 esp-hosted; Wokwi 中 WiFi 初始化无害但无实际连接)
CONFIG_VBCPET_WIFI_SSID="wokwi"
CONFIG_VBCPET_WIFI_PASSWORD="wokwi123"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 分区表
CONFIG_PARTITION_TABLE_SINGLE_APP=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
