# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ──
.vscode/
.idea/
*.swp

# ── ESP-IDF / firmware ──
firmware/**/build*/
firmware/**/sdkconfig
firmware/**/sdkconfig.old
firmware/**/managed_components/
*.bin
*.elf
*.map

# ── KiCad (hardware) ──
hardware/**/*-backups/
hardware/**/*.kicad_prl
hardware/**/*.kicad_sch-bak
hardware/**/*.bak
hardware/**/fp-info-cache
hardware/**/_autosave-*

# ── PC host (Python/Node) ──
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
dist/
build/
.env
.env.*

# ── phone ──
phone/**/build/
phone/**/.gradle/
phone/**/Pods/

# ── Live2D external repos ──
live2d/CubismWebSamples/

# ── 第三方角色模型 (体积大 + 版权归原作者, 不入库) ──
# 本地放进 live2d/models/ 即可使用; 获取方式与放置说明见 live2d/models/README.md
live2d/models/*.vrm
live2d/models/*.glb
live2d/models/*.gltf

# ── Live2D 换皮工具产物 (由 Hiyori 贴图派生, 不入库) ──
live2d/Hiyori.blocks/
live2d/Hiyori.new/
live2d/Hiyori/Hiyori.2048.bak/

# ── Claude session files ──
.claude/

# ── logs / scratch ──
*.log
/tmp/
scratch/

# ── 嘉立创 EDA 本地工程 (大文件/含缓存, 不入库) ──
JLC/
*.epro2

# osptek vendor repo clone (reference only, do not commit)
_osptek/

# ── ESP32-C6 协处理器固件 (firmware_c6) ──
firmware_c6/build/
firmware_c6/managed_components/
firmware_c6/sdkconfig
firmware_c6/sdkconfig.old

# ── WiFi 探测构建配置: 含明文 SSID/密码, 严禁入库 ──
# 缺失时 IDF 会自动从 sdkconfig.defaults 重建, 再 menuconfig 填
# "vbcpet WiFi" 菜单里的 SSID/PASSWORD 即可 (见 firmware/_build_wifi.bat)
firmware/sdkconfig.wifi
firmware_c6/sdkconfig.wifi
